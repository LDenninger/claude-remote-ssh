{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" SessionStart"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" SessionEnd"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "e=PreToolUse r=\"${CLAUDE_PLUGIN_ROOT}\"; . \"$r/scripts/gate.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "e=UserPromptSubmit r=\"${CLAUDE_PLUGIN_ROOT}\"; . \"$r/scripts/gate.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "e=PostToolUse r=\"${CLAUDE_PLUGIN_ROOT}\"; . \"$r/scripts/gate.sh\""
          }
        ]
      }
    ]
  }
}
