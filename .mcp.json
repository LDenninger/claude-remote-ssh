{
  "mcpServers": {
    "remote-ssh": {
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/server.py"],
      "env": {
        "REMOTE_SSH_MESSAGING": "${user_config.messaging}",
        "REMOTE_SSH_POLL_INTERVAL": "${user_config.poll_interval_s}",
        "REMOTE_SSH_SSHFS_OPTIONS": "${user_config.sshfs_options}"
      }
    }
  }
}
